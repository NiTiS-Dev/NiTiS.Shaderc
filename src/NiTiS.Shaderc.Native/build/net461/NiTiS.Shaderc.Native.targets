<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
	<PropertyGroup>
		<_NiTiS_Shaderc_IsWindows Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Windows)))' == 'true'">true</_NiTiS_Shaderc_IsWindows>
		<_NiTiS_Shaderc_IsMacOS Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::OSX)))' == 'true'">true</_NiTiS_Shaderc_IsMacOS>
		<_NiTiS_Shaderc_IsLinux Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Linux)))' == 'true'">true</_NiTiS_Shaderc_IsLinux>

		<_NiTiS_Shaderc_NativeRuntime Condition=" '$(_NiTiS_Shaderc_NativeRuntime)' == '' And '$(_NiTiS_Shaderc_IsLinux)' == 'true' And ('$(Prefer32Bit)' == 'true' Or '$(PlatformTarget)' == 'x86')">linux-x86</_NiTiS_Shaderc_NativeRuntime>
		<_NiTiS_Shaderc_NativeRuntime Condition=" '$(_NiTiS_Shaderc_NativeRuntime)' == '' And '$(_NiTiS_Shaderc_IsLinux)' == 'true' And ('$(Prefer32Bit)' == 'false' Or '$(PlatformTarget)' == 'x64')">linux-x64</_NiTiS_Shaderc_NativeRuntime>
		<_NiTiS_Shaderc_NativeRuntime Condition=" '$(_NiTiS_Shaderc_NativeRuntime)' == '' And '$(_NiTiS_Shaderc_IsLinux)' == 'true' And '$(PlatformTarget)' == 'arm64'">linux-arm64</_NiTiS_Shaderc_NativeRuntime>

		<_NiTiS_Shaderc_NativeRuntime Condition=" '$(_NiTiS_Shaderc_NativeRuntime)' == '' And '$(_NiTiS_Shaderc_IsWindows)' == 'true' And ('$(Prefer32Bit)' == 'true' Or '$(PlatformTarget)' == 'x86')">win-x86</_NiTiS_Shaderc_NativeRuntime>
		<_NiTiS_Shaderc_NativeRuntime Condition=" '$(_NiTiS_Shaderc_NativeRuntime)' == '' And '$(_NiTiS_Shaderc_IsWindows)' == 'true' And ('$(Prefer32Bit)' == 'false' Or '$(PlatformTarget)' == 'x64')">win-x64</_NiTiS_Shaderc_NativeRuntime>
		<_NiTiS_Shaderc_NativeRuntime Condition=" '$(_NiTiS_Shaderc_NativeRuntime)' == '' And '$(_NiTiS_Shaderc_IsWindows)' == 'true' And '$(PlatformTarget)' == 'arm64'">win-arm64</_NiTiS_Shaderc_NativeRuntime>
		
		<_NiTiS_Shaderc_NativeRuntime Condition=" '$(_NiTiS_Shaderc_NativeRuntime)' == '' And '$(_NiTiS_Shaderc_IsMacOS)' == 'true' And ('$(Prefer32Bit)' == 'false' Or '$(PlatformTarget)' == 'x64')">osx-x64</_NiTiS_Shaderc_NativeRuntime>
		<_NiTiS_Shaderc_NativeRuntime Condition=" '$(_NiTiS_Shaderc_NativeRuntime)' == '' And '$(_NiTiS_Shaderc_IsMacOS)' == 'true' And '$(PlatformTarget)' == 'arm64'">osx-arm64</_NiTiS_Shaderc_NativeRuntime>

		<_NiTiS_Shaderc_NativeLibName Condition="'$(_NiTiS_Shaderc_NativeRuntime)' == 'win-x86'">shaderc_shared.dll</_NiTiS_Shaderc_NativeLibName>
		<_NiTiS_Shaderc_NativeLibName Condition="'$(_NiTiS_Shaderc_NativeRuntime)' == 'win-x64'">shaderc_shared.dll</_NiTiS_Shaderc_NativeLibName>
		<_NiTiS_Shaderc_NativeLibName Condition="'$(_NiTiS_Shaderc_NativeRuntime)' == 'win-arm64'">shaderc_shared.dll</_NiTiS_Shaderc_NativeLibName>
		
		<_NiTiS_Shaderc_NativeLibName Condition="'$(_NiTiS_Shaderc_NativeRuntime)' == 'linux-x64'">libshaderc_shared.so</_NiTiS_Shaderc_NativeLibName>
		<_NiTiS_Shaderc_NativeLibName Condition="'$(_NiTiS_Shaderc_NativeRuntime)' == 'linux-x86'">libshaderc_shared.so</_NiTiS_Shaderc_NativeLibName>
		<_NiTiS_Shaderc_NativeLibName Condition="'$(_NiTiS_Shaderc_NativeRuntime)' == 'linux-arm64'">libshaderc_shared.so</_NiTiS_Shaderc_NativeLibName>
		
		<_NiTiS_Shaderc_NativeLibName Condition="'$(_NiTiS_Shaderc_NativeRuntime)' == 'osx-arm64'">libshaderc_shared.dylib</_NiTiS_Shaderc_NativeLibName>
		<_NiTiS_Shaderc_NativeLibName Condition="'$(_NiTiS_Shaderc_NativeRuntime)' == 'osx-x64'">libshaderc_shared.dylib</_NiTiS_Shaderc_NativeLibName>
	</PropertyGroup>
	<ItemGroup>
		<Content Condition="'$(_NiTiS_Shaderc_NativeRuntime)' != ''" Include="$(MSBuildThisFileDirectory)..\..\runtimes\$(_NiTiS_Shaderc_NativeRuntime)\native\$(_NiTiS_Shaderc_NativeLibName)">
			<Link>%(Filename)%(Extension)</Link>
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
			<Visible>False</Visible>
		</Content>
	</ItemGroup>
</Project>
